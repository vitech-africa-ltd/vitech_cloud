# ============================================
# VITECH CLOUD — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================
# APPLICATION
# ============================================

# Application URL (used for redirects, CORS, etc.)
VITE_APP_URL=http://localhost:5173

# Application domain (for production)
VITE_APP_DOMAIN=cloud.vitechafrica.com

# ============================================
# SUPABASE (Backend & Database)
# ============================================

# Get these from: https://app.supabase.com → Your project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (NEVER expose in frontend - server-side only)
# Get from: https://app.supabase.com → Your project → Settings → API
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# CLOUDFLARE R2 (Object Storage)
# ============================================

# Get these from: https://dash.cloudflare.com → R2 → Overview
R2_ACCOUNT_ID=your-account-id

# Create API token: https://dash.cloudflare.com → R2 → Manage R2 API Tokens
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key

# Bucket name (create in R2 dashboard)
R2_BUCKET_NAME=vitech-cloud

# R2 endpoint (find in R2 bucket settings)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# ============================================
# FEATURE FLAGS
# ============================================

# Enable/disable features
VITE_ENABLE_ORGANIZATIONS=false
VITE_ENABLE_FILE_VERSIONS=false
VITE_ENABLE_REALTIME=false
VITE_ENABLE_ANALYTICS=true

# ============================================
# LIMITS & QUOTAS
# ============================================

# Maximum upload size in bytes (default: 5 GB)
VITE_MAX_UPLOAD_SIZE=5368709120

# Default storage quota per user in bytes (default: 10 GB)
VITE_DEFAULT_QUOTA=10737418240

# Maximum files per upload batch
VITE_MAX_FILES_PER_UPLOAD=100

# Share link duration in seconds (default: 7 days)
VITE_SHARE_LINK_DURATION=604800

# Days to keep files in trash before permanent delete
VITE_TRASH_RETENTION_DAYS=30

# ============================================
# THIRD-PARTY SERVICES (Optional)
# ============================================

# Stripe (for future billing)
# VITE_STRIPE_PUBLIC_KEY=your-stripe-public-key
# STRIPE_SECRET_KEY=your-stripe-secret-key

# SendGrid (for email notifications)
# SENDGRID_API_KEY=your-sendgrid-api-key
# SENDGRID_FROM_EMAIL=noreply@vitechafrica.com

# Sentry (for error tracking)
# VITE_SENTRY_DSN=your-sentry-dsn

# ============================================
# NOTES
# ============================================

# - If VITE_SUPABASE_URL is not set, the app runs in DEMO mode
#   using localStorage for data persistence.
# - Never commit real credentials to version control.
# - Variables with VITE_ prefix are exposed to the browser.
# - Variables without VITE_ prefix are server-side only.
# - Use different .env files for different environments:
#   .env.development
#   .env.staging
#   .env.production
